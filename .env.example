# Copy to .env (never commit .env)
GEMINI_API_KEY=your-google-ai-studio-key
# gemma-4-26b-a4b-it (default, faster) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# The UNO Q's IP on venue Wi-Fi; leave unreachable/unset to run in mock mode
BOARD_URL=http://192.168.1.50:8080
# weather.gov rejects requests without a User-Agent
NWS_USER_AGENT=opencity-harness (your-email@example.com)
